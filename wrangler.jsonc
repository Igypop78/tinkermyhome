// Cloudflare Worker: statické súbory z dist/ + /api/live (worker.js). Build: node build.mjs
// Tajomstvo LIVE_TOKEN: Settings → Variables and Secrets (rovnaký token má HA v secrets.yaml).
{
  "name": "tinkermyhome",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LIVE", "class_name": "LiveStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveStore"] }]
}
